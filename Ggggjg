local function spin()
	local f=F3X()if not f then return end
	local chars={}for _,plr in pairs(P:GetPlayers())do if plr.Character then chars[plr.Character]=true end end
	local rot,n=CFrame.Angles(math.rad(15),0,0),0
	for _,v in pairs(workspace:GetDescendants())do
		if v:IsA("BasePart")and v.Parent then
			local sk=false
			for ch in pairs(chars)do if v:IsDescendantOf(ch)then sk=true break end end
			if sk then continue end
			local nm=v.Name:lower()
			if nm:find("head")or nm:find("torso")or nm:find("arm")or nm:find("leg")or nm=="humanoidrootpart"then continue end
			n+=1
			task.spawn(function()pcall(function()f.SL(v,false)task.wait(.02)f.MV(v,v.CFrame*rot)end)end)
			if n%25==0 then task.wait(.04)end
		end
	end
end

