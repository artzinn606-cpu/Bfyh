local function parent(g)
	g.ResetOnSpawn=false
	g.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
	g.DisplayOrder=999999
	g.IgnoreGuiInset=true
	local ok,h=pcall(function()return gethui()end)
	if ok and h then g.Parent=h return end
	ok=pcall(function()g.Parent=game:GetService("CoreGui")end)
	if ok and g.Parent then return end
	pcall(function()
		if syn and syn.protect_gui then syn.protect_gui(g)end
	end)
	g.Parent=LP:WaitForChild("PlayerGui")
end

local function hd(c)
	pcall(function()
		local x=S:FindFirstChild("HDAdminHDClient")
		if x and x.Signals then
			local r=x.Signals:FindFirstChild("RequestCommandSilent")
			if r then r:InvokeServer(c)end
		end
	end)
end

local function getT()
	for _,v in pairs(LP:GetDescendants())do if v.Name=="SyncAPI"then return v.Parent end end
	for _,v in pairs(game:GetDescendants())do if v.Name=="SyncAPI"then return v.Parent end end
end

local function F3X()
	local t=getT()if not t then return end
	local r=t.SyncAPI.ServerEndpoint
	local function _(a)r:InvokeServer(unpack(a))end
	local f={}
	f.CP=function(cf,p)_({[1]="CreatePart",[2]="Normal",[3]=cf,[4]=p or workspace})end
	f.SN=function(p,n)_({[1]="SetName",[2]={[1]=p},[3]=n})end
	f.AM=function(p)_({[1]="CreateMeshes",[2]={{["Part"]=p}}})end
	f.SM=function(p,id)_({[1]="SyncMesh",[2]={{["Part"]=p,["MeshId"]="rbxassetid://"..id}}})end
	f.ST=function(p,id)_({[1]="SyncMesh",[2]={{["Part"]=p,["TextureId"]="rbxassetid://"..id}}})end
	f.MR=function(p,s)_({[1]="SyncMesh",[2]={{["Part"]=p,["Scale"]=s}}})end
	f.SL=function(p,b)_({[1]="SetLocked",[2]={[1]=p},[3]=b})end
	f.SA=function(b,p)_({[1]="SyncAnchor",[2]={{["Part"]=p,["Anchored"]=b}}})end
	f.SD=function(p,s)_({[1]="CreateTextures",[2]={{["Part"]=p,["Face"]=s,["TextureType"]="Decal"}}})end
	f.AD=function(p,id,s)_({[1]="SyncTexture",[2]={{["Part"]=p,["Face"]=s,["TextureType"]="Decal",["Texture"]=id==""and""or("rbxassetid://"..id)}}})end
	f.RS=function(p,s,cf)_({[1]="SyncResize",[2]={{["Part"]=p,["CFrame"]=cf,["Size"]=s}}})end
	f.MV=function(p,cf)_({[1]="SyncMove",[2]={{["Part"]=p,["CFrame"]=cf}}})end
	f.TR=function(p,i)_({[1]="SyncMaterial",[2]={{["Part"]=p,["Transparency"]=i}}})end
	f.CL=function(p,c)_({[1]="SyncColor",[2]={{["Part"]=p,["Color"]=c,["UnionColoring"]=false}}})end
	f.RM=function(p)_({[1]="Remove",[2]={[1]=p}})end
	f.Sky=function(id)
		for _,v in pairs(workspace:GetChildren())do
			if v:IsA("BasePart")and(v.Name=="Sky"or v.Name:lower():find("sky"))then pcall(function()f.RM(v)end)end
		end
		task.wait(.12)local ch=LP.Character if not ch then return end
		local pos=ch.HumanoidRootPart.CFrame+Vector3.new(0,6,0)
		f.CP(pos)task.wait(.12)
		for _,v in pairs(workspace:GetChildren())do
			if v:IsA("BasePart")and(v.Position-pos.Position).Magnitude<1.5 then
				f.SN(v,"Sky")f.AM(v)f.SM(v,"111891702759441")f.ST(v,id)
				f.MR(v,Vector3.new(1000,1000,1000))f.SL(v,true)f.SA(true,v)break
			end
		end
	end
	f.spam=function(id)
		for _,v in pairs(workspace:GetDescendants())do
			if v:IsA("BasePart")then
				task.spawn(function()pcall(function()
					f.SL(v,false)
					for _,s in pairs({Enum.NormalId.Front,Enum.NormalId.Back,Enum.NormalId.Left,Enum.NormalId.Right,Enum.NormalId.Top,Enum.NormalId.Bottom})do
						f.SD(v,s)f.AD(v,id,s)
					end
				end)end)
			end
		end
	end
	return f
end

