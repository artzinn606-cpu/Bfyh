local function realm()
	local f=F3X()if not f then return end
	local function find(pos)
		task.wait(.12)
		for _,v in pairs(workspace:GetChildren())do
			if v:IsA("BasePart")and(v.Position-pos).Magnitude<5 then return v end
		end
	end
	hd(";punish all")task.wait(.12)hd(";sm welcome to The realm of roblox_user!")
	for _,v in pairs(workspace:GetDescendants())do
		if v:IsA("BasePart")and(v.Size.X>=15 or v.Size.Z>=15 or v.Name:lower():find("base"))then
			pcall(function()f.MV(v,CFrame.new(0,-800,0))f.SA(true,v)end)
		end
